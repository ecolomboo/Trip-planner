# Copy to `.env.local` and fill in. Never commit real secrets.

# --- Supabase ---
# Project URL and anon key — public, safe to ship to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. REQUIRED: provisions the sign-in users
# (email-only auth). Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by the keep-alive action
# (`.github/workflows/supabase-keepalive.yml`).
SUPABASE_DB_URL=

# --- Access control ---
# Optional: who may sign in, comma-separated. If unset, the two travellers are
# allowed by default. Sign-in trusts the email alone (no email is sent).
# Example: ALLOWED_EMAILS=edocolombo@hotmail.it,noeceriotti@gmail.com
ALLOWED_EMAILS=
