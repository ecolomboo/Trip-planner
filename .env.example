# Copy to `.env.local` and fill in. Never commit real secrets.

# --- Supabase ---
# Project URL and anon key — public, safe to ship to the client bundle.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. Bypasses RLS; never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string, used only by the keep-alive action
# (`.github/workflows/supabase-keepalive.yml`).
SUPABASE_DB_URL=

# --- Deploy ---
# Public URL of the deployed app, used to build the magic-link redirect.
# Leave unset in development — the app derives it from the request host.
SITE_URL=

# --- Access control ---
# Comma-separated list of emails allowed to sign in. Invite-only: two users.
ALLOWED_EMAILS=you@example.com,partner@example.com
